{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "spdx_identifier",
    "official_license_url",
    "normalized_attribution",
    "status",
    "attribution_required",
    "change_indication_required",
    "product_provenance_required"
  ],
  "properties": {
    "scope": {
      "type": ["string", "null"]
    },
    "spdx_identifier": {
      "type": ["string", "null"]
    },
    "official_license_url": {
      "type": ["string", "null"]
    },
    "normalized_attribution": {
      "type": ["string", "null"]
    },
    "status": {
      "enum": ["supported", "invalid"]
    },
    "attribution_required": {
      "type": ["boolean", "null"]
    },
    "change_indication_required": {
      "type": ["boolean", "null"]
    },
    "product_provenance_required": {
      "type": ["boolean", "null"]
    }
  }
}
