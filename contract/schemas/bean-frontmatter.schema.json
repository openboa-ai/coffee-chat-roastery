{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "origins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "allOf": [
          {
            "pattern": "^https://[^\\s/?#@:.]+(?:\\.[^\\s/?#@:.]+)+(?:\\.)?(?::[0-9]+)?(?:[/?#]|$)"
          },
          {
            "not": {
              "pattern": "^https://(?:0[xX][0-9A-Fa-f]+|[0-9]+)(?:\\.(?:0[xX][0-9A-Fa-f]+|[0-9]+)){0,3}(?::[0-9]+)?(?:[/?#]|$)"
            }
          },
          {
            "not": {
              "pattern": "^https://(?:[^/?#@:]+\\.)*(?:[lL][oO][cC][aA][lL][hH][oO][sS][tT]|[lL][oO][cC][aA][lL]|[iI][nN][tT][eE][rR][nN][aA][lL]|[iI][nN][vV][aA][lL][iI][dD]|[tT][eE][sS][tT]|[eE][xX][aA][mM][pP][lL][eE]|[hH][oO][mM][eE]\\.[aA][rR][pP][aA]|[oO][nN][iI][oO][nN])\\.?(?::[0-9]+)?(?:[/?#]|$)"
            }
          }
        ]
      }
    }
  }
}
