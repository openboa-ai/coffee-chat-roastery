{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "license", "attribution"],
  "properties": {
    "scope": {
      "const": "roastery/beans/**"
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
    },
    "attribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "allOf": [
        {
          "not": {
            "const": "<OWNER_PROVIDED_ATTRIBUTION>"
          }
        },
        {
          "not": {
            "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]"
          }
        }
      ]
    }
  }
}
