{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openboa-ai/coffee-chat-roastery/contract/schemas/content-license.schema.json",
  "title": "Standard Roastery Bean content license",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "license", "attribution"],
  "properties": {
    "scope": { "const": "roastery/beans/**" },
    "license": { "const": "CC-BY-4.0" },
    "attribution": { "type": "string", "minLength": 1, "maxLength": 120 }
  }
}
