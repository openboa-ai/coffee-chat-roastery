{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "evidence_class",
    "fixture_owner",
    "synthetic_repositories",
    "before_tree_digest",
    "after_tree_digest",
    "before_roastery_digest",
    "after_roastery_digest",
    "declaration_bytes",
    "declaration_digest",
    "old_projection_bytes",
    "old_projection_digest",
    "new_projection_bytes",
    "new_projection_digest",
    "projection_bytes_equal",
    "projection_digests_equal",
    "semantic_dimension_negatives",
    "changed_paths",
    "fake_review_boundary",
    "repinning_result",
    "bundle_validation",
    "protected_canary_receipt"
  ],
  "properties": {
    "status": {
      "const": "passed"
    },
    "evidence_class": {
      "const": "fixture"
    },
    "fixture_owner": {
      "type": "string",
      "minLength": 1
    },
    "synthetic_repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b"],
      "properties": {
        "a": {
          "$ref": "#/$defs/bundle"
        },
        "b": {
          "$ref": "#/$defs/bundle"
        }
      }
    },
    "before_tree_digest": {
      "$ref": "#/$defs/digest"
    },
    "after_tree_digest": {
      "$ref": "#/$defs/digest"
    },
    "before_roastery_digest": {
      "$ref": "#/$defs/digest"
    },
    "after_roastery_digest": {
      "$ref": "#/$defs/digest"
    },
    "declaration_bytes": {
      "type": "string",
      "minLength": 1
    },
    "declaration_digest": {
      "$ref": "#/$defs/digest"
    },
    "old_projection_bytes": {
      "type": "string",
      "minLength": 1
    },
    "old_projection_digest": {
      "$ref": "#/$defs/digest"
    },
    "new_projection_bytes": {
      "type": "string",
      "minLength": 1
    },
    "new_projection_digest": {
      "$ref": "#/$defs/digest"
    },
    "projection_bytes_equal": {
      "const": true
    },
    "projection_digests_equal": {
      "const": true
    },
    "semantic_dimension_negatives": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "spdx_identifier",
        "official_license_url",
        "normalized_attribution",
        "status",
        "attribution_required",
        "change_indication_required",
        "product_provenance_required"
      ],
      "properties": {
        "scope": {
          "const": "rejected"
        },
        "spdx_identifier": {
          "const": "rejected"
        },
        "official_license_url": {
          "const": "rejected"
        },
        "normalized_attribution": {
          "const": "rejected"
        },
        "status": {
          "const": "rejected"
        },
        "attribution_required": {
          "const": "rejected"
        },
        "change_indication_required": {
          "const": "rejected"
        },
        "product_provenance_required": {
          "const": "rejected"
        }
      }
    },
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fake_review_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing", "wrong_owner", "stale_head", "exact_owner_head"],
      "properties": {
        "missing": {
          "const": "rejected"
        },
        "wrong_owner": {
          "const": "rejected"
        },
        "stale_head": {
          "const": "rejected"
        },
        "exact_owner_head": {
          "const": "accepted"
        }
      }
    },
    "repinning_result": {
      "const": "passed"
    },
    "bundle_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b"],
      "properties": {
        "a": {
          "const": "passed"
        },
        "b": {
          "const": "passed"
        }
      }
    },
    "protected_canary_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "digest"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
