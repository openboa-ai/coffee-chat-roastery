{
  "repository": "https://github.com/openboa-ai/coffee-chat-roastery",
  "digest": {
    "algorithm": "sha256",
    "file_count_bytes": 4,
    "path_length_bytes": 4,
    "content_length_bytes": 8,
    "byte_order": "big-endian",
    "path_base": "repository",
    "path_order": "utf8-bytewise"
  },
  "content_license": {
    "scope": "roastery/beans/**",
    "spdx_identifier": "CC-BY-4.0",
    "official_license_url": "https://creativecommons.org/licenses/by/4.0/",
    "attribution_normalization": "NFC",
    "supported": true,
    "attribution_required": true,
    "change_indication_required": true,
    "product_provenance_required": true
  },
  "files": {
    "roastery_schema": "contract/schemas/roastery.schema.json",
    "index_schema": "contract/schemas/index.schema.json",
    "bean_frontmatter_schema": "contract/schemas/bean-frontmatter.schema.json",
    "content_license_schema": "contract/schemas/content-license.schema.json",
    "content_license_template": "contract/templates/content-license.md",
    "init_contract": "contract/init.md",
    "publication_contract": "contract/publication.md",
    "security_contract": "contract/security.md",
    "public_cli": "dist/cli.js",
    "contract_digest": "dist/contract/digest.js",
    "contract_manifest_parser": "dist/contract/manifest.js",
    "contract_types": "dist/contract/types.js",
    "public_api": "dist/index.js",
    "content_license_renderer": "dist/projection/content-license.js",
    "index_projection": "dist/projection/index.js",
    "bean_validator": "dist/validation/bean.js",
    "content_license_parser": "dist/validation/content-license.js",
    "contract_bundle_validator": "dist/validation/contract-bundle.js",
    "filesystem_validator": "dist/validation/filesystem.js",
    "index_validator": "dist/validation/index.js",
    "publication_validator": "dist/validation/publication.js",
    "repository_validator": "dist/validation/repository.js",
    "roastery_validator": "dist/validation/roastery.js"
  }
}
