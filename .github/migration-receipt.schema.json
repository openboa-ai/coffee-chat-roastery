{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/openboa-ai/coffee-chat-roastery/blob/main/.github/migration-receipt.schema.json",
  "title": "Coffee Chat repository migration execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_owner",
    "task",
    "objective",
    "base_commit",
    "execution_identity_receipt_sha256",
    "target_bootstrap_receipt_sha256",
    "projection_sha256",
    "equality_receipt_sha256",
    "changed_surfaces_sha256",
    "changed_surfaces",
    "migrate_evidence",
    "rewrite_evidence",
    "exclude_evidence",
    "verification"
  ],
  "properties": {
    "schema": { "const": "coffee-chat/migration-receipt" },
    "target_owner": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "base_commit": { "$ref": "#/$defs/sha1" },
    "base_tree": { "$ref": "#/$defs/sha1" },
    "empty_base_tree": { "$ref": "#/$defs/sha1" },
    "execution_identity_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "target_bootstrap_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "projection_sha256": { "$ref": "#/$defs/sha256" },
    "equality_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "changed_surfaces_sha256": { "$ref": "#/$defs/sha256" },
    "changed_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "migrate_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/migrateEvidence" }
    },
    "rewrite_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rewriteEvidence" }
    },
    "exclude_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/excludeEvidence" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_deterministic",
        "same_repository_ci",
        "exact_head_review",
        "squash_merge",
        "control_plane"
      ],
      "properties": {
        "local_deterministic": { "enum": ["passed", "failed"] },
        "same_repository_ci": { "$ref": "#/$defs/externalStatus" },
        "exact_head_review": { "$ref": "#/$defs/externalStatus" },
        "squash_merge": { "$ref": "#/$defs/externalStatus" },
        "control_plane": { "$ref": "#/$defs/externalStatus" }
      }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "externalStatus": {
      "enum": ["pending", "passed", "failed", "unavailable"]
    },
    "migrateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "source_ref",
        "source_commit",
        "source_path",
        "source_blob_oid",
        "source_sha256",
        "target_path",
        "target_sha256",
        "status"
      ],
      "properties": {
        "source_repository": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "source_blob_oid": { "$ref": "#/$defs/sha1" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "target_path": { "type": "string", "minLength": 1 },
        "target_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["passed", "failed", "unavailable"] }
      }
    },
    "rewriteEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "source_ref",
        "source_commit",
        "source_path",
        "rationale_code",
        "oracle_code",
        "source_objective_or_failure_mode",
        "replacement_observable_oracle",
        "status",
        "evidence"
      ],
      "properties": {
        "source_repository": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "rationale_code": { "type": "string", "minLength": 1 },
        "oracle_code": { "type": "string", "minLength": 1 },
        "source_objective_or_failure_mode": {
          "type": "string",
          "minLength": 1
        },
        "replacement_observable_oracle": {
          "type": "string",
          "minLength": 1
        },
        "status": { "enum": ["passed", "failed", "unavailable"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "excludeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "source_ref",
        "source_commit",
        "source_path",
        "checked_target_paths",
        "status"
      ],
      "properties": {
        "source_repository": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "checked_target_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": { "enum": ["passed", "failed", "unavailable"] }
      }
    }
  }
}
