{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/openboa-ai/coffee-chat-roastery/blob/main/.github/migration-equality-receipt.schema.json",
  "title": "Coffee Chat migration equality input receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_owner",
    "task",
    "objective",
    "ledger_sha256",
    "generator_sha256",
    "objective_selection_sha256",
    "projection_sha256",
    "changed_surface_classification_sha256"
  ],
  "properties": {
    "schema": { "const": "coffee-chat/migration-equality-inputs" },
    "target_owner": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "ledger_sha256": { "$ref": "#/$defs/sha256" },
    "generator_sha256": { "$ref": "#/$defs/sha256" },
    "objective_selection_sha256": { "$ref": "#/$defs/sha256" },
    "projection_sha256": { "$ref": "#/$defs/sha256" },
    "changed_surface_classification_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
