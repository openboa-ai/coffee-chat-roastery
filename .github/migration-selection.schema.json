{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/openboa-ai/coffee-chat-roastery/blob/main/.github/migration-selection.schema.json",
  "title": "Coffee Chat scoped migration selection projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_owner",
    "task",
    "objective",
    "ledger_sha256",
    "selected_rows",
    "changed_surface_classification"
  ],
  "properties": {
    "schema": { "const": "coffee-chat/migration-selection-projection" },
    "target_owner": { "$ref": "#/$defs/nonEmpty" },
    "task": { "$ref": "#/$defs/nonEmpty" },
    "objective": { "$ref": "#/$defs/nonEmpty" },
    "ledger_sha256": { "$ref": "#/$defs/sha256" },
    "selected_rows": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/selectedRow" }
    },
    "changed_surface_classification": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/ledgerDerived" },
          { "$ref": "#/$defs/newAuthority" }
        ]
      }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "blob": { "type": "string", "pattern": "^(?:-|[0-9a-f]{40})$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "source_ref",
        "source_commit",
        "source_path"
      ],
      "properties": {
        "source_repository": { "$ref": "#/$defs/nonEmpty" },
        "source_ref": { "$ref": "#/$defs/nonEmpty" },
        "source_commit": { "$ref": "#/$defs/nonEmpty" },
        "source_path": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "selectedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "source_ref",
        "source_commit",
        "source_path",
        "source_blob_oid",
        "content_sha256",
        "action",
        "target_owner",
        "target_path_or_surface",
        "rationale_code",
        "oracle_code",
        "confidence",
        "migration_state"
      ],
      "properties": {
        "source_repository": { "$ref": "#/$defs/nonEmpty" },
        "source_ref": { "$ref": "#/$defs/nonEmpty" },
        "source_commit": { "$ref": "#/$defs/nonEmpty" },
        "source_path": { "$ref": "#/$defs/nonEmpty" },
        "source_blob_oid": { "$ref": "#/$defs/blob" },
        "content_sha256": {
          "type": "string",
          "pattern": "^(?:-|[0-9a-f]{64})$"
        },
        "action": { "enum": ["migrate", "rewrite", "exclude"] },
        "target_owner": { "$ref": "#/$defs/nonEmpty" },
        "target_path_or_surface": { "$ref": "#/$defs/nonEmpty" },
        "rationale_code": { "$ref": "#/$defs/nonEmpty" },
        "oracle_code": { "$ref": "#/$defs/nonEmpty" },
        "confidence": { "$ref": "#/$defs/nonEmpty" },
        "migration_state": { "$ref": "#/$defs/nonEmpty" },
        "source_objective_or_failure_mode": { "$ref": "#/$defs/nonEmpty" },
        "replacement_observable_oracle": { "$ref": "#/$defs/nonEmpty" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "rewrite" } } },
          "then": {
            "properties": {
              "source_objective_or_failure_mode": {
                "$ref": "#/$defs/nonEmpty"
              },
              "replacement_observable_oracle": {
                "$ref": "#/$defs/nonEmpty"
              }
            },
            "required": [
              "source_objective_or_failure_mode",
              "replacement_observable_oracle"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "source_objective_or_failure_mode": true
                  },
                  "required": ["source_objective_or_failure_mode"]
                },
                {
                  "properties": {
                    "replacement_observable_oracle": true
                  },
                  "required": ["replacement_observable_oracle"]
                }
              ]
            }
          }
        }
      ]
    },
    "ledgerDerived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_path_or_surface", "classification", "selected_rows"],
      "properties": {
        "target_path_or_surface": { "$ref": "#/$defs/nonEmpty" },
        "classification": { "const": "ledger-derived" },
        "selected_rows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identity" }
        }
      }
    },
    "newAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_path_or_surface",
        "classification",
        "objective_or_failure_mode",
        "observable_oracle"
      ],
      "properties": {
        "target_path_or_surface": { "$ref": "#/$defs/nonEmpty" },
        "classification": { "const": "new-authority" },
        "objective_or_failure_mode": { "$ref": "#/$defs/nonEmpty" },
        "observable_oracle": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
